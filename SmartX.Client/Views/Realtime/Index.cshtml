@{ ViewData["Title"] = "Real-Time Command Stream"; }
@Html.AntiForgeryToken()
<div class="smart-header"><div><p class="eyebrow">SMART-X / DEVICE OPERATIONS</p><h1>Real-Time Command Stream</h1><p>Live telemetry, priority alerts, manual overrides and predictive insights.</p></div><span id="connection" class="connection">Connecting...</span></div>
<div class="metrics"><div class="smart-card"><span>Registered devices</span><strong id="deviceCount">—</strong></div><div class="smart-card"><span>Active alerts</span><strong id="alertCount">—</strong></div><div class="smart-card"><span>FIFO pending</span><strong id="fifoCount">—</strong></div><div class="smart-card"><span>Priority pending</span><strong id="priorityCount">—</strong></div></div>
<div class="smart-grid"><section class="smart-card"><h2>Device Explorer</h2><div class="filters"><input id="search" placeholder="Search device or category" aria-label="Search devices"/><input id="category" placeholder="Filter category" aria-label="Filter category"/><label><input type="checkbox" id="alertsOnly"/> Alerts only</label></div><div class="table-wrap"><table><thead><tr><th>Device</th><th>Category</th><th>State</th><th>Alert</th></tr></thead><tbody id="devices"><tr><td colspan="4">Loading...</td></tr></tbody></table></div></section>
<section class="smart-card"><h2>Manual Override</h2><form id="commandForm"><label>Device ID<input id="deviceId" required placeholder="Registered device ID"/></label><label>Action<select id="action"><option value="PUMP_ON">Turn pump on</option><option value="PUMP_OFF">Turn pump off</option><option value="RELAY_ON">Relay on</option><option value="RELAY_OFF">Relay off</option><option value="VALVE_OPEN">Open valve</option><option value="VALVE_CLOSE">Close valve</option></select></label><div class="actions"><button type="submit">Send Command</button><button type="button" class="secondary" id="undo">Undo Last Command</button></div></form><p id="feedback" role="status"></p><h2>Simulate Sensor</h2><form id="simulateForm"><label>Category<input id="simCategory" value="moisture" required/></label><label>Value<input id="simValue" type="number" value="12" step="any" required/></label><label><input id="critical" type="checkbox" checked/> Critical alert</label><button type="submit">Send Telemetry to API</button></form></section></div>
<div class="smart-grid"><section class="smart-card"><h2>Automated Insights</h2><ul id="suggestions"><li>Waiting for data...</li></ul><h2>Active Alert Devices</h2><div id="alerts"></div><button id="process" class="secondary" type="button">Process Next Queued Packet</button></section><section class="smart-card"><h2>Command History</h2><div id="commands" class="scroll-list"></div></section></div>
<section class="smart-card"><h2>Sensor Timeline</h2><div class="table-wrap"><table><thead><tr><th>Time (UTC)</th><th>Device</th><th>Category</th><th>Reading</th><th>Status</th></tr></thead><tbody id="timeline"></tbody></table></div></section>
@section Scripts { <script src="~/js/realtime.js" asp-append-version="true"></script> }
