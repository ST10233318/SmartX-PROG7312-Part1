@{ ViewData["Title"] = "Mesh Network Topology"; }
<h1>Mesh Network Topology</h1>
<p>Live graph data from the Smart-X API. Link weights represent illustrative routing cost, not measured power use.</p>
<div class="row g-3 mb-3"><div class="col-md-4"><div class="card card-body"><strong>Nodes</strong><h2 id="nodesCount">—</h2></div></div><div class="col-md-4"><div class="card card-body"><strong>Reachable</strong><h2 id="onlineCount">—</h2></div></div><div class="col-md-4"><div class="card card-body"><strong>MST total cost</strong><h2 id="mstCost">—</h2></div></div></div>
<div class="card card-body mb-3"><h3>Network diagram</h3><svg id="networkSvg" viewBox="0 0 800 420" role="img" aria-label="Graph of sensors and connections" style="width:100%;max-height:420px;background:#101a30;border-radius:12px"></svg><p class="small text-muted">Cyan links: connections. Green links: minimum spanning tree. Grey nodes: unreachable.</p></div>
<div class="row g-3"><div class="col-lg-6"><div class="card card-body"><h3>Connect nodes</h3><form id="connectForm"><input class="form-control mb-2" id="from" placeholder="From (e.g. Gateway)" required /><input class="form-control mb-2" id="to" placeholder="To (e.g. Sensor-A)" required /><input class="form-control mb-2" id="weight" type="number" step="0.1" min="0.1" value="2" required /><button class="btn btn-primary">Add connection</button></form><p id="connectionMessage" role="status"></p></div></div><div class="col-lg-6"><div class="card card-body"><h3>Trace MST route</h3><input class="form-control mb-2" id="destination" placeholder="Sensor ID / MAC address" /><button class="btn btn-primary" id="traceBtn">Trace route</button><p id="routeResult" role="status"></p><h4>Unreachable nodes</h4><div id="offline"></div></div></div></div>
<div class="card card-body mt-3"><h3>Historical telemetry (AVL tree)</h3><form id="historyForm" class="row g-2"><div class="col-md-3"><input class="form-control" id="device" placeholder="Sensor ID" /></div><div class="col-md-3"><input class="form-control" id="fromDate" type="datetime-local" required /></div><div class="col-md-3"><input class="form-control" id="toDate" type="datetime-local" required /></div><div class="col-md-3"><button class="btn btn-primary w-100">Query range</button></div></form><div class="table-responsive"><table class="table mt-3"><thead><tr><th>Time (UTC)</th><th>Sensor</th><th>Value</th><th>Anomaly</th></tr></thead><tbody id="historyRows"></tbody></table></div><p id="historyMessage" role="status"></p></div>
@section Scripts { <script src="~/js/network.js" asp-append-version="true"></script> }
