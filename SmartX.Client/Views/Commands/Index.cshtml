@{ ViewData["Title"] = "Command Stream"; }
<h1>Command Stream &amp; History</h1><p>Commands are queued for demonstration; no physical device acknowledgement is implemented.</p>
<div class="card card-body mb-3"><form id="commandForm" class="row g-2"><div class="col-md-4"><input class="form-control" id="commandDevice" required placeholder="Registered sensor ID" /></div><div class="col-md-4"><select class="form-select" id="commandAction"><option>ON</option><option>OFF</option><option>RESTART</option><option>STATUS</option></select></div><div class="col-md-4"><button class="btn btn-primary w-100">Queue command</button></div></form><p id="commandMessage" role="status"></p></div><div class="card card-body"><h3>Command history</h3><div class="table-responsive"><table class="table"><thead><tr><th>Created (UTC)</th><th>Sensor</th><th>Action</th><th>Status</th></tr></thead><tbody id="commandRows"></tbody></table></div><button class="btn btn-outline-secondary" id="refreshCommands">Refresh</button></div>
@section Scripts { <script src="~/js/commands.js" asp-append-version="true"></script> }
