@model SmartX.Client.Models.DashboardViewModel

@{
    ViewData["Title"] = "Smart-X Dashboard";
}

<div class="row mb-4">

    <div class="col-md-4">
        <div class="card border-success shadow-sm">
            <div class="card-body">
                <h5>✓ Sensor Data Ingestion</h5>
                <p class="text-muted">
                    Active in Part 1
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5>🔒 Command Stream & History</h5>
                <p class="text-muted">
                    Disabled — Part 2
                </p>
                <button class="btn btn-secondary"
                        disabled>
                    Coming Soon
                </button>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5>🔒 Network Topology</h5>
                <p class="text-muted">
                    Disabled — Final PoE
                </p>
                <button class="btn btn-secondary"
                        disabled>
                    Coming Soon
                </button>
            </div>
        </div>
    </div>

</div>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Smart-X IoT Dashboard</h1>
            <p class="text-muted">
                Sensor Data Ingestion & Telemetry
            </p>
        </div>

        <span class="badge bg-success">
            API Connected
        </span>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Total Sensors</h6>
                    <h2>@Model.TotalSensors</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Online Sensors</h6>
                    <h2>@Model.OnlineSensors</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Total Readings</h6>
                    <h2>@Model.TotalReadings</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-danger">
                <div class="card-body">
                    <h6>Anomalies</h6>
                    <h2 class="text-danger">
                        @Model.Anomalies
                    </h2>
                </div>
            </div>
        </div>

    </div>

    @if (Model.Anomalies > 0)
    {
        <div class="alert alert-danger">
            <strong>Attention required!</strong>
            Smart-X has detected
            @Model.Anomalies anomalous telemetry reading(s).
            Review the telemetry table below.
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-header">
            <h4>Latest Telemetry</h4>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover">

                    <thead>
                        <tr>
                            <th>Device</th>
                            <th>Category</th>
                            <th>Location</th>
                            <th>Value</th>
                            <th>Status</th>
                            <th>Time</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var reading
                            in Model.LatestReadings)
                        {
                            <tr class="@(reading.IsAnomaly
                                                            ? "table-danger"
                                                            : "")">

                                <td>
                                    @reading.DeviceId
                                </td>

                                <td>
                                    @reading.Category
                                </td>

                                <td>
                                    @reading.Location
                                </td>

                                <td>
                                    <strong>
                                        @reading.DisplayValue
                                    </strong>
                                </td>

                                <td>
                                    @if (reading.IsAnomaly)
                                    {
                                        <span class="badge bg-danger">
                                            ANOMALY
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            NORMAL
                                        </span>
                                    }
                                </td>

                                <td>
                                    @reading.Timestamp.ToLocalTime()
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>